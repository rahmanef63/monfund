# Copy to .env.local. Every key is NEXT_PUBLIC_* — nothing here is a secret.

# The MonFund factory the app reads campaigns from, on Monad testnet (chain
# 10143). Paste the address the deploy step prints — DEMO.md §9 step 3 reads it
# out of the CreateCall log. Left empty (or malformed) the app renders a
# misconfiguration banner naming this variable and lists nothing.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Optional. Defaults to https://testnet-rpc.monad.xyz when omitted.
NEXT_PUBLIC_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Optional. Publishable Para client key for embedded MPC wallets. Left empty
# the app falls back to injected-wallet connect only. Mint one with
# `npm i -g @getpara/cli && para login` — it needs a browser OAuth login.
NEXT_PUBLIC_PARA_API_KEY=
